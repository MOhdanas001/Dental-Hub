<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { title: 'My Orders - Dental Hub' }) %>

<style>
/* My Orders Page Custom Styles */
.my-orders-container {
  margin-top: 2rem;
  margin-bottom: 2rem;
}

/* Card styling */
.my-orders-container .card {
  border-radius: 12px;
  overflow: hidden;
}

/* Header */
.my-orders-container .card-header {
  background-color: #f8f9fa;
  font-size: 0.95rem;
}

/* Table images */
.my-orders-container img {
  max-width: 60px;
}
</style>

<body>
    <%- include('partials/navbar') %>

    <div class="container my-orders-container my-5">
        <h2 class="mb-4 text-center">My Orders</h2>

        <% if (!orders || orders.length === 0) { %>
          <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> You have not placed any orders yet.
          </div>
        <% } else { %>
          <% orders.forEach(order => { %>
            <div class="card mb-4 shadow-sm">
              <!-- Card Header -->
              <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                <span class="mb-2 mb-md-0">
                  <strong>Order ID:</strong> <%= order.id %>
                </span>
                <span class="badge badge-primary text-uppercase"><%= order.status %></span>
              </div>

              <!-- Responsive Table -->
              <div class="card-body p-0">
                <div class="table-responsive">
                  <table class="table table-bordered mb-0">
                    <thead class="thead-dark">
                      <tr>
                        <th>Image</th>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Subtotal</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% order.items.forEach(item => { %>
                        <tr>
                          <td class="text-center">
                            <% if (item.img) { %>
                              <img src="<%= item.img %>" alt="<%= item.productName %>" width="60" class="rounded">
                            <% } else { %>
                              <span class="text-muted">Image N/A</span>
                            <% } %>
                          </td>
                          <td>
                            <% if (item.productName && item.price !== null) { %>
                              <%= item.productName %>
                            <% } else { %>
                              <span class="text-danger">Product Deleted</span>
                            <% } %>
                          </td>
                          <td>
                            <% if (item.price !== null) { %>
                              ₹<%= item.price %>
                            <% } else { %>
                              N/A
                            <% } %>
                          </td>
                          <td><%= item.quantity %></td>
                          <td>
                            <% if (item.subtotal !== null) { %>
                              ₹<%= item.subtotal %>
                            <% } else { %>
                              N/A
                            <% } %>
                          </td>
                          <td><%= order.status %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- Card Footer -->
              <div class="card-footer text-right">
                <strong>Total: ₹<%= order.final %></strong><br>
                <small class="text-muted">Placed on <%= new Date(order.createdAt).toDateString() %></small>
              </div>
            </div>
          <% }) %>
        <% } %>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
