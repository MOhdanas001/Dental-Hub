<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { title: 'Order Confirmation - Dental Hub' }) %>

<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5 mb-5">
        <div class="card shadow-lg p-4">
            <h2 class="text-success text-center mb-4">✅ Order Confirmed!</h2>
            <p class="text-center">Thank you for shopping with us, <%= currentUser ? (currentUser.username || currentUser.useremail) : '' %>!</p>

            <h5>Order Details</h5>
            <ul class="list-group mb-3">
                <% items.forEach(item => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><%= item.product.productName %> (x<%= item.quantity %>)</span>
                        <span>₹<%= item.product.price * item.quantity %></span>
                    </li>
                <% }) %>
            </ul>

            <div class="border-top pt-3">
                <p><strong>Order ID:</strong> <%= orderId %></p>
                <p><strong>Total:</strong> ₹<%= total %></p>
            </div>

            <% if (typeof address !== 'undefined' && address) { %>
                <div class="border-top pt-3">
                    <h5>Delivery Address</h5>
                    <p><%= address.name %></p>
                    <p><%= address.fullAddress %>, <%= address.city %> - <%= address.pincode %></p>
                    <p>Contact: <%= address.contactNumber %></p>
                </div>
            <% } %>

            <div class="text-center mt-4">
                <a href="/" class="btn btn-primary">Continue Shopping</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
