<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { title: 'Admin Products - Dental Hub' }) %>

<body>
    <%- include('partials/adminNavbar') %>

    <div class="container my-5">
        <h2 class="mb-4 text-center">All Products</h2>

        <form class="form-inline mb-4 d-flex justify-content-center" method="GET" action="/admin/products">
            <input type="text" name="search" class="form-control mr-2" placeholder="Search by Name or ID" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>OrgPrice</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof products !== 'undefined' && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <tr>
                                <td><img src="<%= product.img %>" alt="<%= product.productName %>" width="60"></td>
                                <td><%= product.productName %></td>
                                <td><%= product.shortDescription %></td>
                                <td>₹<%= product.originalprice %></td>
                                <td>₹<%= product.price %></td>
                                <td><%= product.totalStock %></td>
                                <td><%= product.category %></td>
                                <td>
                                    <a href="/admin/products/edit/<%= product._id %>" class="btn btn-sm btn-warning">Edit</a>
                                    <a href="/admin/products/delete/<%= product._id %>" class="btn btn-sm btn-danger mt-2" onclick="return confirm('Delete this product?')">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center">No products found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <nav aria-label="Products pagination">
                <ul class="pagination justify-content-center flex-wrap">
                    <% if (currentPage > 1) { %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/products?page=<%= currentPage - 1 %>&search=<%= search %>">Prev</a>
                        </li>
                    <% } %>

                    <% 
                        let startPage = Math.max(1, currentPage - 2);
                        let endPage = Math.min(totalPages, currentPage + 2);
                        
                        if (startPage > 1) { 
                    %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/products?page=1&search=<%= search %>">1</a>
                        </li>
                        <% if (startPage > 2) { %>
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        <% } %>
                    <% } %>

                    <% for (let i = startPage; i <= endPage; i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link" href="/admin/products?page=<%= i %>&search=<%= search %>"><%= i %></a>
                        </li>
                    <% } %>

                    <% if (endPage < totalPages) { %>
                        <% if (endPage < totalPages - 1) { %>
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        <% } %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/products?page=<%= totalPages %>&search=<%= search %>"><%= totalPages %></a>
                        </li>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/products?page=<%= currentPage + 1 %>&search=<%= search %>">Next</a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        <% } %>
    </div>

    <%- include('partials/footer') %>
</body>
</html>