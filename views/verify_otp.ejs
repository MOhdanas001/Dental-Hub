<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { title: 'Reset Password - Dental Hub' }) %>

<body>
    <%- include('partials/navbar') %>

    <div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-md-6 col-lg-5">
            <h2 class="text-center mb-4">Reset Password</h2>
            <div class="contact-form bg-light p-4 shadow rounded">
                <form action="/reset" method="post">
                    <!-- Hidden Email -->
                    <input type="hidden" name="email" value="<%= email %>" />

                    <div class="form-group mb-3">
                        <input name="otp" type="text" class="form-control" placeholder="Enter OTP" maxlength="6" required />
                    </div>
                    <div class="form-group mb-3">
                        <input name="newPassword" type="password" class="form-control" placeholder="Enter New Password" required />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-block">Change Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
