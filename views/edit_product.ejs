<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { title: 'Edit Product - Dental Hub Admin' }) %>

<body>
    <%- include('partials/adminNavbar') %>

    <div class="container my-5">
        <h2 class="mb-4 text-center">Edit Product</h2>
        <form method="POST" action="/admin/products/edit/<%= products._id %>" enctype="multipart/form-data">
            <div class="form-group">
                <label>Product Name</label>
                <input type="text" name="productName" class="form-control" value="<%= products.productName %>" required>
            </div>
            <div class="form-group">
                <label>Original Price (₹)</label>
                <input type="number" name="originalprice" class="form-control" value="<%= products.originalprice %>" required>
            </div>
            <div class="form-group">
                <label>Price (₹)</label>
                <input type="number" name="price" class="form-control" value="<%= products.price %>" required>
            </div>
            <div class="form-group">
                <label>Total Stock</label>
                <input type="number" name="totalStock" class="form-control" value="<%= products.totalStock %>" required>
            </div>
            <div class="form-group">
                <label>Short Description</label>
                <input type="text" name="shortDescription" value="<%= products.shortDescription %>" class="form-control">
            </div>
            <div class="form-group">
                <label>Long Description</label>
                <textarea name="longDescription" class="form-control"><%= products.longDescription %></textarea>
            </div>
            <div class="form-group">
                <label>Category</label>
                <select name="category" class="form-control">
                    <option value="dental" <%= products.category === 'dental' ? 'selected' : '' %>>Dental</option>
                    <option value="stationary" <%= products.category === 'stationary' ? 'selected' : '' %>>Stationary</option>
                </select>
            </div>
            <div class="form-group">
                <label>Top Seller</label>
                <select name="top" class="form-control">
                    <option value="yes" <%= products.isTopSeller ? 'selected' : '' %>>Yes</option>
                    <option value="no" <%= !products.isTopSeller ? 'selected' : '' %>>No</option>
                </select>
            </div>
            <div class="form-group">
                <label>Information</label>
                <textarea name="information" class="form-control"><%= products.information %></textarea>
            </div>
            <div class="form-group">
                <label>HSN No</label>
                <input type="text" value="<%= products.hsnNo ? products.hsnNo : '' %>" name="hsnNo" class="form-control">
            </div>
            <div class="form-group">
                <label>SGST</label>
                <input type="number" value="<%= products.SGST ? products.SGST : '' %>" name="sgst" class="form-control" required>
            </div>
            <div class="form-group">
                <label>CGST</label>
                <input type="number" value="<%= products.CGST ? products.CGST : '' %>" name="cgst" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Upload Image</label>
                <input type="file" name="img" class="form-control-file">
            </div>

            <button type="submit" class="btn btn-primary">Update Product</button>
            <a href="/admin/products" class="btn btn-secondary">Cancel</a>
        </form>
    </div>

    <%- include('partials/footer') %>
</body>
</html>