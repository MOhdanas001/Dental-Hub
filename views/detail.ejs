    <script>






const searchBoxes = document.querySelectorAll(".searchBox");
  const suggestionLists = document.querySelectorAll(".suggestions");

  searchBoxes.forEach((searchBox, index) => {
    const suggestions = suggestionLists[index]; // match corresponding <ul>
    let timeout = null;

    searchBox.addEventListener("input", () => {
      clearTimeout(timeout);

      const query = searchBox.value.trim();

      if (!query) {
        suggestions.innerHTML = "";
        return;
      }

      timeout = setTimeout(async () => {
        try {
          const response = await fetch(`/search-suggest?q=${encodeURIComponent(query)}`);
          const data = await response.json();

          // Clear old suggestions
          suggestions.innerHTML = "";

          if (data.length === 0) {
            suggestions.innerHTML = `<li class="list-group-item">No results</li>`;
            return;
          }

          data.forEach(product => {
            const li = document.createElement("li");
            li.classList.add("list-group-item", "list-group-item-action");
            li.textContent = product.productName;
            li.addEventListener("click", () => {
              window.location.href = `/detail/${product._id}`;
            });
            suggestions.appendChild(li);
          });

        } catch (err) {
          console.error("Suggestion fetch error:", err);
        }
      }, 400); // debounce
    });
  });



        document.querySelectorAll(".add-to-cart").forEach(button => {
          button.addEventListener("click", async () => {
            console.log("jashdsagdsgadygasuhdg")
            const productId = button.getAttribute("data-id");
        
            try {
              const res = await fetch("/cart/add", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify({ productId, quantity: 1 })
              });
        
              const data = await res.json();
        
              if (data.success) {
                alert(data.message); 
                // 🚀 Instead of alert, you can update cart counter in navbar
              } else {
                alert("Error adding to cart");
              }
        
            } catch (err) {
              console.error(err);
              alert("Something went wrong!");
            }
          });
        });
        </script>
