<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { title: 'Search Results - Dental Hub' }) %>

<body>
    <%- include('partials/navbar') %>

    <div class="container-fluid pt-5 pb-3">
        <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4">
            <span class="bg-secondary pr-3">Search Results for "<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>"</span>
        </h2>
        <div class="row px-xl-5">
            <% if (typeof Products !== 'undefined' && Products.length > 0) { %>
                <% Products.forEach(product => { %>
                    <%- include('partials/productCard', { product: product, getInclusivePrice: typeof getInclusivePrice !== 'undefined' ? getInclusivePrice : null }) %>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <h4>No products found matching your search.</h4>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>