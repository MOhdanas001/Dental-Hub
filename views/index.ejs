<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>

<body>
    <%- include('partials/navbar') %>

    <!-- Carousel Start -->
    <div class="container-fluid mb-3">
        <div class="row px-xl-5">
            <div class="col-lg-8">
                <div id="header-carousel" class="carousel slide carousel-fade mb-30 mb-lg-0" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#header-carousel" data-slide-to="0" class="active"></li>
                        <li data-target="#header-carousel" data-slide-to="1"></li>
                    </ol>
                    <div class="carousel-inner">
                        <div class="carousel-item position-relative active" style="height: 430px;">
                            <img class="position-absolute w-100 h-100" src="img/carousel-1.jpg" style="object-fit: cover;">
                            <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                                <div class="p-3" style="max-width: 700px;">
                                    <h1 class="display-4 text-white mb-3 animate__animated animate__fadeInDown">Your Trusted Partner for Dental Supplies</h1>
                                    <p class="mx-md-5 px-5 animate__animated animate__bounceIn">Discover high-quality dental products trusted by professionals and individuals alike. From daily care essentials to advanced tools — everything you need, all in one place.</p>
                                    <a class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp" href="#">Shop Now</a>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item position-relative" style="height: 430px;">
                            <img class="position-absolute w-100 h-100" src="img/carousel-2.jpg" style="object-fit: cover;">
                            <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                                <div class="p-3" style="max-width: 700px;">
                                    <h1 class="display-4 text-white mb-3 animate__animated animate__fadeInDown">Smile Brighter, Live Healthier</h1>
                                    <p class="mx-md-5 px-5 animate__animated animate__bounceIn">Shop our wide range of dental care products designed to keep your smile healthy and confident. Affordable prices, reliable quality, and doorstep delivery.</p>
                                    <a class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp" href="#">Shop Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="product-offer mb-30" style="height: 200px;">
                    <img class="img-fluid" src="img/service-2.jpg" alt="">
                    <div class="offer-text">
                        <h6 class="text-white text-uppercase">Save 20%</h6>
                        <h3 class="text-white mb-3">Special Offer On Dentals</h3>
                        <a href="/dentalproducts" class="btn btn-primary">Shop Now</a>
                    </div>
                </div>
                <div class="product-offer mb-30" style="height: 200px;">
                    <img class="img-fluid" src="img/service-3.jpg" alt="">
                    <div class="offer-text">
                        <h6 class="text-white text-uppercase">Save 20%</h6>
                        <h3 class="text-white mb-3">Special Offer On Stationary</h3>
                        <a href="/stationaryproducts" class="btn btn-primary">Shop Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Carousel End -->

    <!-- Featured Start -->
    <div class="container-fluid pt-5">
        <div class="row px-xl-5 pb-3">
            <div class="col-lg-3 col-md-6 col-sm-12 pb-1">
                <div class="d-flex align-items-center bg-light mb-4" style="padding: 30px;">
                    <h1 class="fa fa-check text-primary m-0 mr-3"></h1>
                    <h5 class="font-weight-semi-bold m-0">Quality Product</h5>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-12 pb-1">
                <div class="d-flex align-items-center bg-light mb-4" style="padding: 30px;">
                    <h1 class="fa fa-shipping-fast text-primary m-0 mr-2"></h1>
                    <h5 class="font-weight-semi-bold m-0">Free Delivery in Rohtak</h5>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-12 pb-1">
                <div class="d-flex align-items-center bg-light mb-4" style="padding: 30px;">
                    <h1 class="fas fa-exchange-alt text-primary m-0 mr-3"></h1>
                    <h5 class="font-weight-semi-bold m-0">Minimum delivery Cost</h5>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-12 pb-1">
                <div class="d-flex align-items-center bg-light mb-4" style="padding: 30px;">
                    <h1 class="fa fa-envelope text-primary m-0 mr-3"></h1>
                    <h5 class="font-weight-semi-bold m-0">Free Delivery over 2000 all over India</h5>
                </div>
            </div>
        </div>
    </div>
    <!-- Featured End -->

    <!-- Top Sellers Start -->
    <div class="container-fluid pt-5 pb-3">
        <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4"><span class="bg-secondary pr-3">Top Sellers</span></h2>
        <div class="row px-xl-5">
            <% if (typeof top !== 'undefined' && top.length > 0) { %>
                <% top.forEach(product => { %>
                    <%- include('partials/productCard', { product: product, getInclusivePrice: getInclusivePrice }) %>
                <% }) %>
            <% } %>
        </div>
    </div>
    <!-- Top Sellers End -->

    <!-- Offer Start -->
    <div class="container-fluid pt-5 pb-3">
        <div class="row px-xl-5">
            <div class="col-md-6">
                <div class="product-offer mb-30" style="height: 300px;">
                    <img class="img-fluid" src="img/cat1.jpg" alt="">
                    <div class="offer-text">
                        <h3 class="text-white mb-3">All Dental Products</h3>
                        <a href="/dentalproducts" class="btn btn-primary">Shop Now</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="product-offer mb-30" style="height: 300px;">
                    <img class="img-fluid" src="img/cat2.webp" alt="">
                    <div class="offer-text">
                        <h3 class="text-white mb-3">All Stationary Products</h3>
                        <a href="/stationaryproducts" class="btn btn-primary">Shop Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Offer End -->

    <!-- Featured Products Start -->
    <div class="container-fluid pt-5 pb-3">
        <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4"><span class="bg-secondary pr-3">Featured Products</span></h2>
        <div class="row px-xl-5">
            <% if (typeof Products !== 'undefined' && Products.length > 0) { %>
                <% Products.forEach(product => { %>
                    <%- include('partials/productCard', { product: product, getInclusivePrice: getInclusivePrice }) %>
                <% }) %>
            <% } %>
        </div>
    </div>
    <!-- Featured Products End -->

    <!-- Vendor Start -->
    <div class="container-fluid py-5">
        <div class="row px-xl-5">
            <div class="col">
                <div class="owl-carousel vendor-carousel">
                    <div class="p-4"><img src="img/vendor-1.png" alt=""></div>
                    <div class="p-4"><img src="img/vendor-2.png" alt=""></div>
                    <div class="p-4"><img src="img/vendor-3.png" alt=""></div>
                    <div class="p-4"><img src="img/vendor-4.png" alt=""></div>
                    <div class="p-4"><img src="img/vendor-5.png" alt=""></div>
                    <div class="p-4"><img src="img/vendor-6.png" alt=""></div>
                    <div class="p-4"><img src="img/vendor-7.png" alt=""></div>
                    <div class="p-4"><img src="img/vendor-8.png" alt=""></div>
                    <div class="p-4"><img src="img/vendor-9.png" alt=""></div>
                </div>
            </div>
        </div>
    </div>
    <!-- Vendor End -->

    <%- include('partials/footer') %>
</body>
</html>