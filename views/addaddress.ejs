<!DOCTYPE html>
<html lang="en">

<%- include('partials/head', { title: 'Add / Update Address - Dental Hub' }) %>

<body>
    <%- include('partials/navbar') %>

    <div class="container py-5">
        <h2 class="mb-4">Add / Update Address</h2>

        <form action="/addaddress" method="POST" class="row g-3">
            <!-- Name -->
            <div class="col-md-6">
                <label for="name" class="form-label">Name</label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="name" 
                    name="name" 
                    value="<%= address ? address.name : (user ? user.username : '') %>" 
                    required>
            </div>

            <!-- Email -->
            <div class="col-md-6">
                <label for="email" class="form-label">Email</label>
                <input 
                    type="email" 
                    class="form-control" 
                    id="email" 
                    name="email" 
                    value="<%= user ? user.useremail : '' %>" 
                    required>
            </div>

            <!-- City -->
            <div class="col-md-6">
                <label for="city" class="form-label mt-2">City</label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="city" 
                    name="city" 
                    value="<%= address ? address.city : '' %>">
            </div>

            <!-- Pincode -->
            <div class="col-md-6">
                <label for="pincode" class="form-label mt-2">Pincode</label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="pincode" 
                    name="pincode" 
                    value="<%= address ? address.pincode : '' %>">
            </div>

            <!-- Full Address -->
            <div class="col-12">
                <label for="fullAddress" class="form-label mt-2">Full Address</label>
                <textarea 
                    class="form-control" 
                    id="fullAddress" 
                    name="fullAddress" 
                    rows="3"><%= address ? address.fullAddress : '' %></textarea>
            </div>

            <!-- Contact Number -->
            <div class="col-md-6">
                <label for="contactNumber" class="form-label mt-2">Contact Number</label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="contactNumber" 
                    name="contactNumber" 
                    value="<%= address ? address.contactNumber : '' %>">
            </div>

            <!-- Submit -->
            <div class="col-12 mt-3">
                <button type="submit" class="btn btn-primary">Review Order</button>
            </div>
        </form>
    </div>

    <%- include('partials/footer') %>
</body>
</html>